# station.env — what makes one machine a studiobox station.
#
# Copy to station/local/<hostname>.env (git-ignored) and adapt, then run
#   sudo station/install.sh --env station/local/<hostname>.env all
# install.sh copies it to /etc/studiobox/station.env, which the services read.

# --- Who runs it, from where -------------------------------------------------
# A blank machine gets a system user and a fresh clone; on a desktop machine
# point both at your own user and checkout.
RUN_USER=studiobox
APP_DIR=/opt/radiobox
REPO_URL=https://github.com/FreieRadios/radiobox.git
REPO_REF=main
# Node 20+. Empty: /usr/bin/node (Debian 13 ships 20.x as `nodejs`).
NODE_BIN=
# Config template, generated config, session state (Einmessen, trims).
STATE_DIR=/var/lib/studiobox
TIMEZONE=Europe/Berlin

# --- Programme output to a USB sound card ------------------------------------
# Checked at every start of the service, in this order, against the names in
# /proc/asound/cards (id or description, case-insensitive). The first one
# plugged in gets the programme; with none, the local output stays off and the
# stream (below) carries the programme alone. Empty: leave the template as is.
OUTPUT_CARDS="MAYA22 M4"

# --- Stream for other boxes and for listening --------------------------------
# install.sh writes the harbor URL into the template from these.
STREAM_ENABLED=yes
# local: an Icecast on this machine (apt icecast2, or a running icecast2
# container is reused). Anything else is taken as a full icecast:// URL.
STREAM_SERVER=local
STREAM_MOUNT=/studiobox
# mp3 plays everywhere (Safari on the iPad); ogg-flac is lossless but only
# for boxes and desktop browsers.
STREAM_FORMAT=mp3
ICECAST_SOURCE_PASSWORD=

# --- Studio WLAN for the tablets ---------------------------------------------
# The Wi-Fi card becomes an access point at every boot. The tablets reach the
# box at http://<AP_ADDRESS>:4445. A card that is the AP is not a client of
# any other Wi-Fi.
AP_ENABLED=yes
AP_IFACE=
AP_SSID=studiobox
# 8..63 characters. Empty: install.sh generates one and writes it back here.
AP_PASSPHRASE=
# bg = 2.4 GHz (works with every card and every tablet), a = 5 GHz.
AP_BAND=bg
AP_CHANNEL=6
AP_ADDRESS=10.42.0.1/24

# --- Cable to a playout box (e.g. the Pi at the desk) ------------------------
# A second Ethernet port hands out addresses on its own subnet; the box behind
# it plays http://<LAN_ADDRESS without /24>:8000<STREAM_MOUNT>.
LAN_SHARE_ENABLED=no
LAN_IFACE=
LAN_ADDRESS=10.43.0.1/24

# --- Audio from Nextcloud ---------------------------------------------------
# A Nextcloud folder kept on the box (music, jingles, pre-produced shows), in
# sync every 5 minutes, from boot on, without a desktop login. Two-way: what is
# deleted on the server goes here too, so never record into this folder.
# Empty URL or user: the `nextcloud` step asks. The app password is always
# asked (Nextcloud: Personal settings > Security > Devices & sessions) and kept
# only in /etc/studiobox/nextcloud.env (root-only), never in this file.
NEXTCLOUD_ENABLED=no
NEXTCLOUD_URL=
NEXTCLOUD_USER=
# The folder on the server ("/" = everything the user has, e.g. /audio).
NEXTCLOUD_PATH=/
# Where it lands on the box. Empty: STATE_DIR/nextcloud. Add it to
# filePlayer.dirs in the template to play from it.
NEXTCLOUD_DIR=

# --- Playout box only: play a stream into the desk ---------------------------
# Used by the `relay` step on the receiving box (it replaces studiobox.service
# there while it runs).
RELAY_URL=http://10.43.0.1:8000/studiobox
RELAY_DEVICE=default
